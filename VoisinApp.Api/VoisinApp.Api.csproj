<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VoisinApp.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Si NuGet signale qu'une version 10.0.* n'existe pas, installez la dernière
         version stable de chaque paquet via "Gérer les packages NuGet". -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
  </ItemGroup>

</Project>
