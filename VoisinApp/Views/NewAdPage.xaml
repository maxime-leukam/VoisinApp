<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VoisinApp.Views.NewAdPage"
             Title="Nouvelle annonce"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BrandPaper}">

    <Grid x:Name="Container"
          RowDefinitions="Auto,*"
          HorizontalOptions="Center"
          VerticalOptions="Fill">

        <!-- Barre du haut -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="72,*,72">
            <Button Text="←"
                    FontSize="24"
                    TextColor="{StaticResource BrandDark}"
                    BackgroundColor="Transparent"
                    WidthRequest="56"
                    HeightRequest="56"
                    Padding="0"
                    HorizontalOptions="Start"
                    Margin="12,8,0,8"
                    SemanticProperties.Description="Retour"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1"
                   Text="Nouvelle annonce"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource BrandDark}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            <BoxView Grid.Row="1" Grid.ColumnSpan="3"
                     HeightRequest="1"
                     Color="{StaticResource BrandBorder}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,24,24,32" Spacing="0">

                <!-- Photos -->
                <Border BackgroundColor="#F5F7F2"
                        Stroke="#C9D6CC"
                        StrokeThickness="1.5"
                        StrokeDashArray="4,4"
                        StrokeShape="RoundRectangle 20"
                        HeightRequest="150">
                    <VerticalStackLayout Spacing="6"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="📷" FontSize="30" HorizontalOptions="Center" />
                        <Label Text="Ajouter des photos"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandGreen}"
                               HorizontalOptions="Center" />
                        <Label Text="Jusqu'à 5 photos"
                               FontSize="12"
                               TextColor="{StaticResource BrandMuted}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddPhotosTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Type d'annonce -->
                <Label Text="Type d'annonce"
                       Margin="0,24,0,10"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource BrandDark}" />

                <Border BackgroundColor="{StaticResource BrandCream}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="4">
                    <Grid x:Name="TypeGrid" ColumnDefinitions="*,*,*" ColumnSpacing="4">
                        <Border Grid.Column="0" ClassId="À vendre" HeightRequest="44"
                                StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <Label Text="À vendre" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTypeTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="1" ClassId="À donner" HeightRequest="44"
                                StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <Label Text="À donner" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTypeTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="2" ClassId="Service" HeightRequest="44"
                                StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <Label Text="Service" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTypeTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </Border>

                <!-- Titre -->
                <Label Text="Titre"
                       Margin="0,22,0,8"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource BrandDark}" />
                <Border BackgroundColor="{StaticResource BrandField}"
                        Stroke="{StaticResource BrandBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="56"
                        Padding="18,0">
                    <Entry x:Name="TitleEntry"
                           Placeholder="Que proposez-vous ?"
                           PlaceholderColor="#A3ADA8"
                           ReturnType="Next"
                           FontSize="16"
                           TextColor="{StaticResource BrandDark}"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Titre de l'annonce" />
                </Border>

                <!-- Description -->
                <Label Text="Description"
                       Margin="0,20,0,8"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource BrandDark}" />
                <Border BackgroundColor="{StaticResource BrandField}"
                        Stroke="{StaticResource BrandBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="130"
                        Padding="14,6">
                    <Editor x:Name="DescriptionEditor"
                            Placeholder="État, dimensions, informations utiles…"
                            PlaceholderColor="#A3ADA8"
                            FontSize="16"
                            TextColor="{StaticResource BrandDark}"
                            BackgroundColor="Transparent"
                            SemanticProperties.Description="Description de l'annonce" />
                </Border>

                <!-- Prix (masqué pour "À donner") -->
                <VerticalStackLayout x:Name="PriceSection" Spacing="0">
                    <Label Text="Prix"
                           Margin="0,20,0,8"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource BrandDark}" />
                    <Border BackgroundColor="{StaticResource BrandField}"
                            Stroke="{StaticResource BrandBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            HeightRequest="56"
                            Padding="18,0">
                        <Entry x:Name="PriceEntry"
                               Placeholder="0 FCFA"
                               PlaceholderColor="#A3ADA8"
                               Keyboard="Numeric"
                               FontSize="16"
                               TextColor="{StaticResource BrandDark}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               SemanticProperties.Description="Prix en FCFA" />
                    </Border>
                </VerticalStackLayout>

                <Button Text="Publier l'annonce"
                        Margin="0,24,0,0"
                        BackgroundColor="{StaticResource BrandGreen}"
                        TextColor="White"
                        FontSize="17"
                        FontAttributes="Bold"
                        HeightRequest="56"
                        CornerRadius="18"
                        Clicked="OnPublishClicked">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource BrandGreen}" Offset="0,6" Radius="14" Opacity="0.25" />
                    </Button.Shadow>
                </Button>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
    
</ContentPage>