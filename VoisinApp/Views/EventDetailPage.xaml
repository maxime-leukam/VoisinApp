<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VoisinApp.Views.EventDetailPage"
             Title="Détail évènement"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BrandPaper}">

    <Grid x:Name="Container"
          HorizontalOptions="Center"
          VerticalOptions="Fill">

        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <!-- Image en haut avec bouton retour -->
                <Grid HeightRequest="280">
                    <Image Source="event_party.jpg"
                           Aspect="AspectFill"
                           SemanticProperties.Description="Habitants réunis pour la fête de Bonamoussadi" />
                    <BoxView VerticalOptions="End" HeightRequest="150">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.0" />
                                <GradientStop Color="#B3183A30" Offset="1.0" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <Button Text="←"
                            FontSize="22"
                            TextColor="{StaticResource BrandDark}"
                            BackgroundColor="White"
                            WidthRequest="46" HeightRequest="46"
                            CornerRadius="23"
                            Padding="0"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            Margin="16,16,0,0"
                            SemanticProperties.Description="Retour"
                            Clicked="OnBackClicked" />

                    <Label Text="Fête de&#10;Bonamoussadi"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="End"
                           Margin="24,0,24,20" />
                </Grid>

                <VerticalStackLayout Padding="24,22,24,32" Spacing="0">

                    <Label Text="VIE DE QUARTIER"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           TextColor="#B5473A" />

                    <Label Text="Grande fête de&#10;Bonamoussadi"
                           Margin="0,10,0,0"
                           FontSize="28"
                           FontAttributes="Bold"
                           LineHeight="1.05"
                           TextColor="{StaticResource BrandDark}"
                           SemanticProperties.HeadingLevel="Level1" />

                    <!-- Date -->
                    <Grid Margin="0,22,0,0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border BackgroundColor="{StaticResource BrandCream}" StrokeThickness="0"
                                WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 14">
                            <Label Text="📅" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Samedi 17 mai" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandDark}" />
                            <Label Text="De 14:00 à 21:00" FontSize="13"
                                   TextColor="{StaticResource BrandMuted}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Lieu -->
                    <Grid Margin="0,14,0,0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border BackgroundColor="{StaticResource BrandCream}" StrokeThickness="0"
                                WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 14">
                            <Label Text="📍" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Parcours Vita de Bonamoussadi" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandDark}" />
                            <Label Text="À 8 min à pied" FontSize="13"
                                   TextColor="{StaticResource BrandMuted}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Participants -->
                    <Border Margin="0,20,0,0"
                            BackgroundColor="#F1F6F2"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="14">
                        <HorizontalStackLayout Spacing="14">
                            <HorizontalStackLayout Spacing="-8" VerticalOptions="Center">
                                <Border BackgroundColor="#FBE0D8" Stroke="White" StrokeThickness="2"
                                        WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 17">
                                    <Label Text="AN" FontSize="10" FontAttributes="Bold"
                                           TextColor="{StaticResource BrandDark}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Border BackgroundColor="#DCEBE2" Stroke="White" StrokeThickness="2"
                                        WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 17">
                                    <Label Text="JE" FontSize="10" FontAttributes="Bold"
                                           TextColor="{StaticResource BrandDark}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Border BackgroundColor="#F7E9C6" Stroke="White" StrokeThickness="2"
                                        WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 17">
                                    <Label Text="GN" FontSize="10" FontAttributes="Bold"
                                           TextColor="{StaticResource BrandDark}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </HorizontalStackLayout>
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label x:Name="ParticipantsLabel"
                                       Text="42 voisins participent"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource BrandDark}" />
                                <Label Text="dont 6 que vous connaissez"
                                       FontSize="12"
                                       TextColor="{StaticResource BrandMuted}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- À propos -->
                    <Label Text="À propos"
                           Margin="0,24,0,8"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource BrandDark}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="Musique, jeux pour les enfants, stands gourmands et bonne humeur. Apportez un plat à partager si vous le souhaitez !"
                           FontSize="15"
                           LineHeight="1.3"
                           TextColor="{StaticResource BrandMuted}" />

                    <!-- Participer -->
                    <Button x:Name="JoinButton"
                            Text="✓  Je participe"
                            Margin="0,24,0,0"
                            BackgroundColor="{StaticResource BrandGreen}"
                            TextColor="White"
                            FontSize="17"
                            FontAttributes="Bold"
                            HeightRequest="56"
                            CornerRadius="18"
                            Clicked="OnJoinClicked">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource BrandGreen}" Offset="0,6" Radius="14" Opacity="0.25" />
                        </Button.Shadow>
                    </Button>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>