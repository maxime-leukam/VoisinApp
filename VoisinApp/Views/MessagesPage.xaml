<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VoisinApp.Views.Controls"
             xmlns:models="clr-namespace:VoisinApp.Models"
             x:Class="VoisinApp.Views.MessagesPage"
             Title="Messages"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BrandPaper}">

    <Grid x:Name="Container"
          RowDefinitions="Auto,Auto,*,Auto"
          HorizontalOptions="Center"
          VerticalOptions="Fill">

        <!-- En-tête -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="64,*,64">
            <Label Grid.Column="1"
                   Text="Messages"
                   Margin="0,18"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource BrandDark}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
            <Button Grid.Column="2"
                    Text="+"
                    FontSize="30"
                    TextColor="{StaticResource BrandDark}"
                    BackgroundColor="Transparent"
                    WidthRequest="56" HeightRequest="56" Padding="0"
                    HorizontalOptions="End" VerticalOptions="Center"
                    SemanticProperties.Description="Nouveau message"
                    Clicked="OnNewMessageClicked" />
            <BoxView Grid.Row="1" Grid.ColumnSpan="3"
                     HeightRequest="1"
                     Color="{StaticResource BrandBorder}" />
        </Grid>

        <!-- Recherche -->
        <Border Grid.Row="1"
                Margin="20,16,20,16"
                BackgroundColor="{StaticResource BrandCream}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                HeightRequest="52"
                Padding="16,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="🔍" FontSize="16" VerticalOptions="Center" />
                <Entry x:Name="SearchEntry"
                       Grid.Column="1"
                       Placeholder="Rechercher une conversation"
                       PlaceholderColor="#A3ADA8"
                       FontSize="16"
                       TextColor="{StaticResource BrandDark}"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"
                       TextChanged="OnSearchTextChanged"
                       SemanticProperties.Description="Rechercher une conversation" />
            </Grid>
        </Border>

        <!-- Liste des conversations -->
        <CollectionView x:Name="ConversationsList"
                        Grid.Row="2"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Conversation">
                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="14"
                          Padding="20,14,20,0">

                        <Border Grid.RowSpan="2"
                                BackgroundColor="{Binding AvatarColor}"
                                StrokeThickness="0"
                                WidthRequest="54" HeightRequest="54"
                                VerticalOptions="Start"
                                StrokeShape="RoundRectangle 16">
                            <Label Text="{Binding Initials}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource BrandDark}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource BrandDark}" />
                            <Label Text="{Binding Preview}"
                                   FontSize="14"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{StaticResource BrandMuted}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Start">
                            <Label Text="{Binding Time}"
                                   FontSize="12"
                                   HorizontalOptions="End"
                                   TextColor="{StaticResource BrandMuted}" />
                            <Border BackgroundColor="#E8604C"
                                    StrokeThickness="0"
                                    WidthRequest="22" HeightRequest="22"
                                    HorizontalOptions="End"
                                    IsVisible="{Binding HasUnread}"
                                    StrokeShape="RoundRectangle 11">
                                <Label Text="{Binding UnreadCount}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <BoxView Grid.Row="1" Grid.ColumnSpan="3"
                                 Margin="0,14,0,0"
                                 HeightRequest="1"
                                 Color="{StaticResource BrandBorder}" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnConversationTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="Aucune conversation trouvée."
                       HorizontalOptions="Center"
                       Margin="0,40"
                       TextColor="{StaticResource BrandMuted}" />
            </CollectionView.EmptyView>
        </CollectionView>

        <controls:BottomNavbar Grid.Row="3" ActiveTab="Messages" />

    </Grid>
</ContentPage>