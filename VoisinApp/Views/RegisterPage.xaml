<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VoisinApp.Views.RegisterPage"
             Title="Inscription"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BrandPaper}">

    <Grid x:Name="Container"
          RowDefinitions="Auto,*"
          HorizontalOptions="Center"
          VerticalOptions="Fill">

        <!-- Barre du haut : retour + titre -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto" ColumnDefinitions="72,*,72">
            <Button Text="←"
                    FontSize="24"
                    TextColor="{StaticResource BrandDark}"
                    BackgroundColor="Transparent"
                    WidthRequest="56"
                    HeightRequest="56"
                    Padding="0"
                    HorizontalOptions="Start"
                    Margin="12,8,0,8"
                    SemanticProperties.Description="Retour"
                    Clicked="OnBackClicked" />

            <Label Grid.Column="1"
                   Text="Créer mon compte"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource BrandDark}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <BoxView Grid.Row="1"
                     Grid.ColumnSpan="3"
                     HeightRequest="1"
                     Color="{StaticResource BrandBorder}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,20,24,32" Spacing="0">

                <!-- Barre de progression : 3 étapes -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <BoxView Grid.Column="0" HeightRequest="4" CornerRadius="2" Color="{StaticResource BrandGreen}" />
                    <BoxView Grid.Column="1" HeightRequest="4" CornerRadius="2" Color="{StaticResource BrandGreen}" />
                    <BoxView Grid.Column="2" HeightRequest="4" CornerRadius="2" Color="{StaticResource BrandBorder}" />
                </Grid>

                <Label Text="ÉTAPE 2 SUR 3"
                       Margin="0,20,0,0"
                       FontSize="12"
                       FontAttributes="Bold"
                       CharacterSpacing="1.2"
                       TextColor="{StaticResource BrandGreen}" />

                <Label Text="Trouvons votre quartier"
                       Margin="0,8,0,0"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource BrandDark}"
                       SemanticProperties.HeadingLevel="Level1" />

                <Label Text="Votre adresse reste privée. Elle sert uniquement à vous rattacher à la bonne zone."
                       Margin="0,8,0,0"
                       FontSize="16"
                       LineHeight="1.25"
                       TextColor="{StaticResource BrandMuted}" />

                <!-- Adresse -->
                <Label Text="Adresse ou lieu-dit"
                       Margin="0,28,0,8"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource BrandDark}" />

                <Border BackgroundColor="{StaticResource BrandField}"
                        Stroke="{StaticResource BrandBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="56"
                        Padding="18,0">
                    <Entry x:Name="AddressEntry"
                           Placeholder="Carrefour Maetur, Bonamoussadi"
                           PlaceholderColor="#A3ADA8"
                           ReturnType="Next"
                           FontSize="16"
                           TextColor="{StaticResource BrandDark}"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Adresse ou lieu-dit" />
                </Border>

                <!-- Ville / arrondissement -->
                <Label Text="Ville / arrondissement"
                       Margin="0,20,0,8"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource BrandDark}" />

                <Border BackgroundColor="{StaticResource BrandField}"
                        Stroke="{StaticResource BrandBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="56"
                        Padding="18,0">
                    <Entry x:Name="CityEntry"
                           Placeholder="Douala V"
                           PlaceholderColor="#A3ADA8"
                           ReturnType="Done"
                           FontSize="16"
                           TextColor="{StaticResource BrandDark}"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Ville ou arrondissement" />
                </Border>

                <!-- Zone détectée (valeurs fictives pour l'instant) -->
                <Border x:Name="ZoneCard"
                        Margin="0,20,0,0"
                        BackgroundColor="#EFF6F1"
                        Stroke="#BFD9CC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                BackgroundColor="#DCEBE2"
                                StrokeThickness="0"
                                WidthRequest="44" HeightRequest="44"
                                StrokeShape="RoundRectangle 12">
                            <Label Text="📍"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Zone détectée"
                                   FontSize="12"
                                   TextColor="{StaticResource BrandMuted}" />
                            <Label x:Name="ZoneNameLabel"
                                   Text="Bonamoussadi · Douala V"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource BrandDark}" />
                            <Label x:Name="ZoneCountLabel"
                                   Text="1 284 voisins inscrits"
                                   FontSize="12"
                                   TextColor="{StaticResource BrandMuted}" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="✓"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource BrandGreen}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Certification -->
                <Grid Margin="0,18,0,0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <CheckBox x:Name="CertifyCheck"
                              Color="{StaticResource BrandGreen}"
                              VerticalOptions="Start"
                              CheckedChanged="OnCertifyChanged"
                              SemanticProperties.Description="Je certifie résider dans cette zone" />
                    <Label Grid.Column="1"
                           Text="Je certifie résider dans cette zone et j'accepte la charte de bon voisinage."
                           FontSize="13"
                           LineHeight="1.25"
                           TextColor="{StaticResource BrandMuted}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCertifyLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Bouton -->
                <Button x:Name="ContinueButton"
                        Text="Continuer"
                        Margin="0,18,0,0"
                        BackgroundColor="{StaticResource BrandGreen}"
                        TextColor="White"
                        FontSize="17"
                        FontAttributes="Bold"
                        HeightRequest="56"
                        CornerRadius="18"
                        IsEnabled="False"
                        Opacity="0.5"
                        Clicked="OnContinueClicked">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource BrandGreen}"
                                Offset="0,6"
                                Radius="14"
                                Opacity="0.25" />
                    </Button.Shadow>
                </Button>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>