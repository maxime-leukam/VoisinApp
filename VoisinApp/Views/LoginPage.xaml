<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VoisinApp.Views.LoginPage"
             Title="Connexion"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BrandPaper}">

    <Grid x:Name="Container"
          RowDefinitions="Auto,*"
          HorizontalOptions="Center"
          VerticalOptions="Fill">

        <!-- Barre du haut : retour -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto">
            <Button Text="←"
                    FontSize="24"
                    TextColor="{StaticResource BrandDark}"
                    BackgroundColor="Transparent"
                    WidthRequest="56"
                    HeightRequest="56"
                    Padding="0"
                    HorizontalOptions="Start"
                    Margin="12,8,0,8"
                    SemanticProperties.Description="Retour"
                    Clicked="OnBackClicked" />
            <BoxView Grid.Row="1"
                     HeightRequest="1"
                     Color="{StaticResource BrandBorder}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,32,24,32" Spacing="0">

                <!-- Icône -->
                <Border BackgroundColor="{StaticResource BrandYellowSoft}"
                        StrokeThickness="0"
                        WidthRequest="56" HeightRequest="56"
                        HorizontalOptions="Start"
                        StrokeShape="RoundRectangle 16">
                    <Label Text="🍃"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Text="Bon retour parmi nous"
                       Margin="0,24,0,0"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="{StaticResource BrandDark}"
                       SemanticProperties.HeadingLevel="Level1" />

                <Label Text="Connectez-vous pour retrouver votre quartier."
                       Margin="0,8,0,0"
                       FontSize="16"
                       TextColor="{StaticResource BrandMuted}" />

                <!-- E-mail -->
                <Label Text="Adresse e-mail"
                       Margin="0,32,0,8"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource BrandDark}" />

                <Border BackgroundColor="{StaticResource BrandField}"
                        Stroke="{StaticResource BrandBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="56"
                        Padding="18,0">
                    <Entry x:Name="EmailEntry"
                           Placeholder="vous@exemple.cm"
                           PlaceholderColor="#A3ADA8"
                           Keyboard="Email"
                           ReturnType="Next"
                           FontSize="16"
                           TextColor="{StaticResource BrandDark}"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Adresse e-mail" />
                </Border>

                <!-- Mot de passe -->
                <Label Text="Mot de passe"
                       Margin="0,20,0,8"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource BrandDark}" />

                <Border BackgroundColor="{StaticResource BrandField}"
                        Stroke="{StaticResource BrandBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        HeightRequest="56"
                        Padding="18,0">
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Votre mot de passe"
                           PlaceholderColor="#A3ADA8"
                           IsPassword="True"
                           ReturnType="Done"
                           FontSize="16"
                           TextColor="{StaticResource BrandDark}"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Mot de passe" />
                </Border>

                <Label Text="Mot de passe oublié ?"
                       Margin="0,14,0,0"
                       HorizontalOptions="End"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource BrandGreen}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Bouton -->
                <Button Text="Se connecter"
                        Margin="0,24,0,0"
                        BackgroundColor="{StaticResource BrandGreen}"
                        TextColor="White"
                        FontSize="17"
                        FontAttributes="Bold"
                        HeightRequest="56"
                        CornerRadius="18"
                        Clicked="OnLoginClicked">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource BrandGreen}"
                                Offset="0,6"
                                Radius="14"
                                Opacity="0.25" />
                    </Button.Shadow>
                </Button>

                <!-- Lien inscription -->
                <Label Margin="0,24,0,0"
                       HorizontalOptions="Center"
                       FontSize="15">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Nouveau ici ?"
                                  TextColor="{StaticResource BrandMuted}" />
                            <Span Text="Créer un compte"
                                  TextColor="{StaticResource BrandGreen}"
                                  FontAttributes="Bold">
                                <Span.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCreateAccountTapped" />
                                </Span.GestureRecognizers>
                            </Span>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>